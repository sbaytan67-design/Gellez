@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Gellez Beauty Salon</title>
    <style>
        *{box-sizing: border-box; margin: 0; padding: 0;}
        
        body{
            background: #0b0800;
            font-family: 'Segoe UI', sans-serif;
        }

        .stage{
            position: relative;
            width: min(100vw, calc(100vh * 1320 / 2048));
            margin: 0 auto;
            container-type: inline-size;
        }

        .stage img{
            display: block;
            width: 100%;
            height: auto;
        }

        .btn{
            position: absolute;
            top: 83.25%;
            height: 5.4%;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            font-size: 3cqw;
            font-weight: 600;
            text-decoration: none;
            transition: transform .15s, filter .15s;
        }

            .btn-create {
                left: 10.8%;
                width: 48.3%;
                background: #d4af37;
                color: #000;
            }

            .btn-login {
                left: 59.8%;
                width: 30.1%;
                background: #3a2a00;
                color: #f5e1a4;
                border: 2px solid #d4af37;
            }
    </style>
</head>
<body>
    <main class="stage">
        <img src="~/images/landing-bg.jpg" alt="Gellez Beauty Salon"/>
        <a href="/CreateAccount" class="btn btn-create">Create Account</a>
        <a href="/Login" class="btn btn-login">Login</a>
    </main>
</body>
</html>