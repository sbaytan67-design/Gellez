@page
@model MyAppointmentsModel
@{
    Layout = null;
    Func<decimal, string> peso = v => "\u20B1" + v.ToString("N2");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Appointments - Gellez Beauty Salon</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; font-family: 'Segoe UI', sans-serif; background: linear-gradient(90deg, #000 0%, #3a2a00 50%, #c8921a 100%) fixed; color: #f5e1a4; padding: 24px 16px 60px; }
        .wrap { max-width: 480px; margin: 0 auto; }
        .back { color: #f5e1a4; text-decoration: none; font-size: .9rem; }
        h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 1.8rem; margin: 14px 0 12px; }
        .msg { padding: 10px 14px; border-radius: 12px; font-size: .88rem; margin-bottom: 12px; }
        .msg.ok { background: rgba(52, 168, 83, .2); border: 1px solid #34a853; }
        .msg.err { background: rgba(229, 57, 53, .2); border: 1px solid #e53935; color: #ffb4b0; }
        .appt { display: flex; gap: 14px; align-items: center; background: rgba(0, 0, 0, .5); border: 1px solid #d4af37; border-radius: 18px; padding: 14px; margin-bottom: 12px; }
        .date { flex: 0 0 64px; text-align: center; background: #d4af37; color: #000; border-radius: 14px; padding: 8px 4px; }
        .date b { display: block; font-size: 1.05rem; }
        .date span { font-size: .75rem; }
        .info { flex: 1; font-size: .9rem; line-height: 1.5; min-width: 0; }
        .info small { opacity: .8; }
        .act { text-align: center; }
        .act small { font-size: .72rem; opacity: .7; display: block; max-width: 90px; }
        .btn { display: inline-block; padding: 9px 16px; border: none; border-radius: 999px; background: #d4af37; color: #000; font-size: .85rem; font-weight: 600; cursor: pointer; text-decoration: none; }
        .btn.danger { background: transparent; border: 1px solid #ff8f8a; color: #ff8f8a; }
        .btn.wide { display: block; text-align: center; padding: 13px; font-size: 1rem; margin-top: 14px; }
        .empty { opacity: .85; font-size: .95rem; padding: 10px 0; }
        form { margin: 0; }
    </style>
</head>
<body>
    <div class="wrap">
        <a href="/CustomerDashboard" class="back">&larr; Back</a>
        <h1>My Appointments</h1>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p class="msg ok">@Model.Message</p>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="msg err">@Model.Error</p>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="msg err">@Model.ErrorMessage</p>
        }

        @if (Model.Items.Count == 0)
        {
            <p class="empty">You have no upcoming appointments.</p>
        }

        @foreach (var a in Model.Items)
        {
            <div class="appt">
                <div class="date"><b>@a.When.ToString("MMM d")</b><span>@a.When.ToString("ddd")</span></div>
                <div class="info">
                    <strong>@a.Service</strong><br />
                    @a.When.ToString("h:mm tt") with @(string.IsNullOrEmpty(a.StylistName) ? "any stylist" : a.StylistName)<br />
                    <small>@peso(a.Price)</small>
                </div>
                <div class="act">
                    @if ((a.When - DateTime.Now).TotalHours > 2)
                    {
                        <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Cancel this appointment?');">
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn danger">Cancel</button>
                        </form>
                    }
                    else
                    {
                        <small>Too late to cancel online</small>
                    }
                </div>
            </div>
        }

        <a href="/BookNow" class="btn wide">Book another appointment</a>
        <a href="/MyHistory" class="back" style="display:block;text-align:center;margin-top:16px;">View my history</a>
    </div>
</body>
</html>
