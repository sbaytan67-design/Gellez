@page
@model OwnerDashboardModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Owner - Gellez Beauty Salon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@@700&display=swap" rel="stylesheet" />
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: #0b0800;
                font-family: 'Segoe UI', sans-serif;
            }

            /* Kahon na kasing-hugis ng picture (1320 x 2048) */
            .stage {
                position: relative;
                width: min(100vw, calc(100vh * 1320 / 2048));
                margin: 0 auto;
                container-type: inline-size;
            }

                .stage > img.bg {
                    display: block;
                    width: 100%;
                    height: auto;
                }

            /* Profile (kaliwang itaas) */
            .avatar {
                position: absolute;
                z-index: 3;
                left: 4.5%;
                top: 3%;
                width: 9.8cqw;
                height: 9.8cqw;
                border-radius: 50%;
                border: .6cqw solid #f5e1a4;
                background: #3a2a00;
                color: #f5e1a4;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 5cqw;
                text-decoration: none;
            }

            /* Notification (kanang itaas) */
            .bell-btn {
                position: absolute;
                z-index: 3;
                right: 4.5%;
                top: 3%;
                width: 9.8cqw;
                height: 9.8cqw;
                border-radius: 50%;
                border: .4cqw solid rgba(245, 225, 164, .6);
                background: rgba(0, 0, 0, .25);
                font-size: 5cqw;
                cursor: pointer;
            }

            .badge {
                position: absolute;
                top: -1cqw;
                right: -1cqw;
                min-width: 4.4cqw;
                height: 4.4cqw;
                padding: 0 1cqw;
                border-radius: 999px;
                background: #e53935;
                color: #fff;
                font-size: 2.6cqw;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .notif-panel {
                display: none;
                position: absolute;
                right: 4.5%;
                top: 13.5%;
                width: 68cqw;
                background: #fff;
                color: #222;
                border-radius: 4cqw;
                box-shadow: 0 10px 30px rgba(0, 0, 0, .3);
                z-index: 20;
                overflow: hidden;
            }

                .notif-panel.open {
                    display: block;
                }

                .notif-panel h3 {
                    padding: 3.5cqw 4cqw 2cqw;
                    font-size: max(15px, 3.8cqw);
                }

            .notif-item {
                padding: 2.6cqw 4cqw;
                border-top: 1px solid #f0f0f0;
                font-size: max(13px, 3cqw);
            }

                .notif-item small {
                    display: block;
                    color: #888;
                    margin-top: .8cqw;
                }

                .notif-item.unread {
                    background: #fff8e6;
                }

            /* Search */
            .search {
                position: absolute;
                z-index: 3;
                left: 6.8%;
                top: 15.7%;
                width: 86.4%;
                height: 4.6%;
            }

                .search input {
                    width: 100%;
                    height: 100%;
                    padding-left: 7.5cqw;
                    border: .4cqw solid rgba(245, 225, 164, .55);
                    border-radius: 999px;
                    background: rgba(255, 255, 255, .1);
                    color: #f5e1a4;
                    font-size: 3.6cqw;
                    outline: none;
                }

                    .search input::placeholder {
                        color: rgba(245, 225, 164, .75);
                    }

            /* Pangalan sa tabi ng "Welcome" na nasa picture */
                .welcome-name {
                    position: absolute; z-index: 3;
                    left: 34.6%; top: 22.1%;
                    width: 60%; height: 8.76cqw;
                    display: flex; align-items: flex-end;
                    overflow: hidden;
                    color: #c9a67a;
                    font-family: 'Playfair Display', Georgia, serif;
                    font-weight: 700;
                    fonr-size: 7.6cqw;
                    line-height: 1;
        }
        .welcome-name span { white-space: nowrap; }

            /* Puting kahon: Today's Schedule */
            .card {
                position: absolute;
                z-index: 3;
                left: 5.08%;
                top: 30.27%;
                width: 88.8%;
                height: 26.6%;
                padding: 3cqw 4cqw;
                display: flex;
                flex-direction: column;
                color: #1f1b2d;
            }

            .card-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 1.5cqw;
            }

                .card-head h2 {
                    font-family: 'Playfair Display', Georgia, serif;
                    font-size: 4.4cqw;
                }

            .live {
                font-size: 2.6cqw;
                color: #3b7d4f;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 1.2cqw;
            }

                .live::before {
                    content: '';
                    width: 1.8cqw;
                    height: 1.8cqw;
                    border-radius: 50%;
                    background: #34a853;
                    animation: pulse 1.6s infinite;
                }

            @@keyframes pulse {
                0% {
                    opacity: 1;
                }

                50% {
                    opacity: .25;
                }

                100% {
                    opacity: 1;
                }
            }

            .list {
                flex: 1;
                overflow-y: auto;
            }

            .row {
                display: flex;
                gap: 2.5cqw;
                padding: 1.4cqw 0;
                border-top: 1px solid #e6e2ef;
            }

                .row:first-child {
                    border-top: none;
                }

            .time {
                width: 15cqw;
                flex: 0 0 15cqw;
                padding-top: 1.4cqw;
                font-size: 2.8cqw;
                font-weight: 700;
                color: #4a4560;
            }

            .entry {
                flex: 1;
                background: #f6f4fb;
                border: 1px solid #d5d0e6;
                border-radius: 2.4cqw;
                padding: 1.6cqw 2.2cqw;
                font-size: 3cqw;
            }

                .entry small {
                    display: block;
                    margin-top: .4cqw;
                    color: #6a6580;
                    font-size: 2.5cqw;
                }

            .empty {
                padding: 4cqw 1cqw;
                text-align: center;
                color: #6a6580;
                font-size: 3.2cqw;
            }

            .updated {
                margin-top: 1cqw;
                font-size: 2.2cqw;
                color: #7b7690;
                text-align: right;
            }

            /* Pansamantalang tools sa blangkong bahagi */
            .tools {
                position: absolute;
                z-index: 3;
                left: 5%;
                top: 88.9%;
                width: 90%;
                text-align: center;
                font-size: 2.8cqw;
                color: #f5e1a4;
            }

                .tools form {
                    display: inline;
                }

                .tools button {
                    background: none;
                    border: none;
                    color: #f5e1a4;
                    text-decoration: underline;
                    cursor: pointer;
                    font-size: 2.8cqw;
                    margin: 0 1.5cqw;
                }

                .tiles{
                    position: absolute; z-index: 3;
                    left: 5.08%; top: 59.5%;
                    width: 88.8%;
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 3.2cqw;
                }

                tile{
                    background: #e8e5ef;
                    border-radius: 6cqw;
                    height: 21cqw;
                    display: flex; flex-direction: column;
                    align-items: center; justify-content; center;
                    gap: 1cqw;
                    text-decoration: none;
                    color: #1f1b2d;
                    font-family: 'Playfair Display', Georgia, serif;
                    font-weight: 700; font-size: 3.4cqw; text-align: center;
                    transition: transform .15s;
                }
                .tilw:hover { transform: translateY(-.5cqw);}
                .tilw .icon{ font-size: 7cqw; line-height: 1; }

                .nav{
                    position: absolute; z-index: 5;
                    left: 0; bottom: 0;
                    width: 100%; height: 8.6%;
                    display: flex; justify-content: space-around; align-items: center;
                    background: #e9e7f0;
                    box-shadow: 0 -1cqw 3cqw rgba(0,0,0,.25);
                }
                .nav a {
                    display: flex; flex-direction: column; align-items: center; gap: .4cqw;
                    text-decoration: none; color: #3a3550;
                    font-size: 2.8cqw;
                }
                .nav a .icon { font-size: 5.4cqw;}
                .nav a,active { color: #b4535f; font-weight: 700;}
                .nav a { text-align: center; line-height: 1.1; }
    </style>
</head>
<body>
    <main class="stage">
        <img class="bg" src="~/images/owner-bg.png" alt="Gellez Beauty Salon" />

        <a href="/StaffProfile" class="avatar" title="Profile">@(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName[..1].ToUpper())</a>

        <button type="button" class="bell-btn" id="bellBtn" aria-label="Notifications">🔔<span class="badge">2</span></button>
        <div class="notif-panel" id="notifPanel">
            <h3>Notifications</h3>
            <div class="notif-item unread">New booking received.<small>Sample • Just now</small></div>
            <div class="notif-item unread">A staff member joined the salon.<small>Sample • Today</small></div>
            <div class="notif-item">Welcome to Gellez Beauty Salon!<small>Sample • Yesterday</small></div>
        </div>

        <div class="search">
            <input type="text" id="q" placeholder="Search today's schedule" autocomplete="off" />
        </div>

                <p class="welcome-name" id="welcomeBox"><span id="welcomeText">, @Model.FullName!</span></p>

        <div class="card">
            <div class="card-head">
                <h2>Today's Schedule</h2>
                <span class="live">LIVE</span>
            </div>
            <div class="list" id="list"><p class="empty">Loading...</p></div>
            <p class="updated" id="updated"></p>
        </div>

                <div class="tools">
            Testing:
            <form method="post" asp-page-handler="AddSample"><button type="submit">Add sample appointment</button></form>
            <form method="post" asp-page-handler="ClearSamples"><button type="submit">Clear samples</button></form>
        </div>

        <div class="tiles">
            <a href="/CustomerAccounts" class="tile"><span class="icon">👥</span>Customer Accounts</a>
            <a href="/CustomerHistory" class="tile"><span class="icon">🕘</span>Customer History</a>
            <a href="/StaffAccounts" class="tile"><span class="icon">💈</span>Staff Accounts</a>
            <a href="/Appointments" class="tile"><span class="icon">📅</span>Appointments</a>
        </div>

        <nav class="nav">            
                        <a href="/OwnerDashboard" class="active"><span class="icon">🏠</span>Home</a>
            <a href="/ManageServices"><span class="icon">💲</span>Services &amp; Prices</a>
            <a href="/Reports"><span class="icon">📊</span>Reports</a>
            <a href="/StaffProfile"><span class="icon">👤</span>Profile</a>
        </nav>
    </main>

    <script>
            var all = [];
            var listEl = document.getElementById('list');
            var updEl = document.getElementById('updated');
            var q = document.getElementById('q');

            function esc(s) {
                return String(s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function render() {
                var term = q.value.trim().toLowerCase();
                var items = all.filter(function (a) {
                    return !term || (a.customer + ' ' + a.service + ' ' + a.stylist).toLowerCase().indexOf(term) !== -1;
                });

                if (items.length === 0) {
                    listEl.innerHTML = '<p class="empty">' + (all.length === 0 ? 'No appointments scheduled for today.' : 'No matches found.') + '</p>';
                    return;
                }

                listEl.innerHTML = items.map(function (a) {
                    return '<div class="row">' +
                        '<div class="time">' + esc(a.time) + '</div>' +
                        '<div class="entry"><strong>' + esc(a.customer) + '</strong> - ' + esc(a.service) +
                        '<small>' + (a.stylist ? 'Stylist: ' + esc(a.stylist) + ' • ' : '') + esc(a.status) + '</small></div>' +
                        '</div>';
                }).join('');
            }

            async function load() {
                try {
                    var res = await fetch('?handler=Schedule', { cache: 'no-store' });
                    if (res.status === 401) { window.location = '/OwnerLogin'; return; }
                    var data = await res.json();
                    if (!res.ok) { updEl.textContent = 'Error: ' + (data.error || res.status); return; }
                    all = data;
                    render();
                    updEl.textContent = 'Updated ' + new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', second: '2-digit' });
                } catch (e) {
                    updEl.textContent = 'Offline - retrying...';
                }
            }

            q.addEventListener('input', render);
            load();
            setInterval(load, 15000);
            document.addEventListener('visibilitychange', function () { if (!document.hidden) load(); });

            var bellBtn = document.getElementById('bellBtn');
            var panel = document.getElementById('notifPanel');
            bellBtn.addEventListener('click', function (e) { e.stopPropagation(); panel.classList.toggle('open'); });
            document.addEventListener('click', function () { panel.classList.remove('open'); });

            function fitOneLine(box, target){
                target = target || box;
                target.style.fontSize = '';
                var size = parseFloat(getComputedStyle(target).fontSize);
                while (target.scrollWidth > box.clientWidth && size > 9){
                    size -= 1;
                    target.style.fontSize = size = 'px';
                }
            }

            function fitWelcome(){
                fitOneLine(document.getElementById('welcomeBox'), document.getElementById('welcomeText'));
            }

            fitWelcome();
            window.addEventListener('resize', fitWelcome);
            if (document.fonts && document.fonts.ready) document.font.ready.then(fitWelcome);
    </script>
</body>
</html>