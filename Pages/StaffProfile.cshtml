@page
@model StaffProfileModel
@{
    Layout = null;
    var me = Model.Me!;
    string back = me.Role == "Owner" ? "/OwnerDashboard" : "/StaffDashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profile - Gellez Beauty Salon</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; font-family: 'Segoe UI', sans-serif; background: linear-gradient(90deg, #000 0%, #3a2a00 50%, #c8921a 100%) fixed; color: #f5e1a4; padding: 24px 16px 40px; }
        .wrap { max-width: 440px; margin: 0 auto; }
        .back { color: #f5e1a4; text-decoration: none; font-size: .9rem; }
        .card { margin-top: 14px; background: rgba(0, 0, 0, .5); border: 1px solid #d4af37; border-radius: 22px; padding: 28px 22px; text-align: center; }
        .pic { width: 92px; height: 92px; margin: 0 auto 14px; border-radius: 50%; background: linear-gradient(135deg, #f5e1a4, #c8921a); color: #3a2a00; display: flex; align-items: center; justify-content: center; font-size: 2.4rem; font-weight: 700; }
        h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 1.6rem; }
        .role { display: inline-block; margin-top: 8px; padding: 4px 14px; border-radius: 999px; background: #d4af37; color: #000; font-size: .78rem; font-weight: 700; }
        .email { margin-top: 10px; font-size: .88rem; opacity: .85; }
        h2 { margin: 24px 0 10px; font-size: 1rem; }
        .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
        .chip { padding: 7px 14px; border-radius: 999px; background: rgba(245, 225, 164, .15); border: 1px solid #d4af37; font-size: .85rem; font-weight: 600; }
        .none { font-size: .88rem; opacity: .8; }
        .btn { display: block; width: 100%; margin-top: 12px; padding: 12px; border-radius: 999px; font-size: .95rem; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; border: none; }
        .btn-gold { background: #d4af37; color: #000; }
        .btn-outline { background: transparent; border: 2px solid #d4af37; color: #f5e1a4; }
        .btn:hover { filter: brightness(1.1); }
        form { margin: 0; }
    </style>
</head>
<body>
    <div class="wrap">
        <a href="@back" class="back">&larr; Back</a>

        <div class="card">
            <div class="pic">@(string.IsNullOrEmpty(me.FullName) ? "?" : me.FullName[..1].ToUpper())</div>
            <h1>@me.FullName</h1>
            <span class="role">@me.Role</span>
            <p class="email">@me.Email</p>

            @if (me.Role == "Staff")
            {
                <h2>Services I offer</h2>
                @if (me.Specialties.Count == 0)
                {
                    <p class="none">No services selected yet.</p>
                }
                else
                {
                    <div class="chips">
                        @foreach (var s in me.Specialties)
                        {
                            <span class="chip">@s</span>
                        }
                    </div>
                }
                <a href="/StaffSpecialties" class="btn btn-gold">Edit services</a>
            }

            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="btn btn-outline">Logout</button>
            </form>
        </div>
    </div>
</body>
</html>