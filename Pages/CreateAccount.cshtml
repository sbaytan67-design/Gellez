@page
@model GellezWeb.Pages.CreateAccountModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>  
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create Account - Gellez Beauty Salon</title>
    <style>
        *{box-sizing: border-box; margin: 0; padding: 0;}
        body{
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
                background: linear-gradient(90deg, #000 0%, #3a2a00 50%, #c8921a 100%);
                color: #f5e1a4;
                padding: 24px;
        }
        .card{
            width: 100%;
                max-width: 380px;
                background: rgba(0, 0, 0, .45);
                border: 1px solid #d4af37;
                border-radius: 20px;
                padding: 32px 28px;
                text-align: center;
        }
        h1{font-size: 1.6rem; margin-bottom: 8px;}
        p{font-size: .9rem; opacity: .85; margin-bottom: 22px;}

            .btn {
                display: block;
                margin-top: 14px;
                padding: 13px;
                border-radius: 999px;
                font-size: 1rem;
                font-weight: 600;
                text-decoration: none;
            }

            .btn-gold {
                background: #d4af37;
                color: #000;
            }

            .btn-outline {
                border: 2px solid #d4af37;
                color: #f5e1a4;
            }

            .btn:hover {
                filter: brightness(1.15);
            }

            .back {
                display: inline-block;
                margin-top: 20px;
                color: #f5e1a4;
                font-size: .85rem;
            }
    </style>
</head>
<body>
    <div class="card">
        <h1>Create Account</h1>
        <p class="sub">Sign up as:</p>
        <a href="/CustomerCreate" class="btn btn-gold">Customer</a>
        <a href="/OwnerCreate" class="btn btn-outline">Owner / Staff</a>
        <a href="/" class="back">Back</a>
    </div>
</body>
</html> 